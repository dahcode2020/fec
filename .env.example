# API EMRYS — développement Docker / Neon
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# PostgreSQL central. Remplacez ces deux valeurs avec les informations Neon.
# Ne partagez jamais DATABASE_URL : elle contient le secret de la base.
DATABASE_URL=
DATABASE_SSL=true

# En développement, le site 4174 peut relayer /api vers l’API Neon 8080.
# Laissez vide pour utiliser l’API SQLite de démonstration embarquée dans preview-site.
EMRYS_API_ORIGIN=

# URL publique utilisée pour les liens de vérification et de réinitialisation.
EMRYS_PUBLIC_URL=http://localhost:4174
# En développement uniquement, l’API peut renvoyer les liens dans le JSON.
DEV_EXPOSE_TOKENS=true

# Origines autorisées si l’API est appelée directement depuis un navigateur.
# Avec le proxy Vercel, les appels restent relatifs et cette valeur peut rester vide.
CORS_ORIGINS=http://localhost:4174

# À renseigner uniquement côté serveur, jamais dans le site public.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.emrys-saas.com/api/auth/google/callback
# FEDAPAY_SECRET_KEY=
